features
        chesspieces_new_process {extended__ true, abstract true}
                optional
                        ScrewBody
                        InsertRod
                        InsertBase
                        ScrewBase
                        InsertBody
                        TurnBase
                mandatory
                        PrintBody {abstract true}
                                alternative
                                        PrintPawnBody
                                        PrintKnightBody
                                        PrintQueenBody
                                        PrintRookBody
                                        PrintBishopBody
                                        PrintKingBody
                        CarveReamings {abstract true}
                                alternative
                                        CarveReamings_two
                                        CarveReamings_one
                        InsertPLA
                        CutAluminumBar
                        LoadAluminumBar

constraints
        ScrewBody => InsertBody
        ScrewBody => InsertRod
        InsertBase => TurnBase
        ScrewBase => InsertBase
        ScrewBase => InsertRod

visibility-constraints
        CutAluminumBar vif LoadAluminumBar
        CarveReamings_one vif CutAluminumBar
        CarveReamings_two vif CutAluminumBar
        TurnBase vif CutAluminumBar
        InsertBase vif TurnBase & CarveReamings
        ScrewBase vif InsertBase & InsertRod
        InsertBody vif PrintBody
        ScrewBody vif InsertBody & InsertRod
        PrintBody vif InsertPLA
